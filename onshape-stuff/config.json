    "output_format": "mujoco",
    "robotName": "my_humanoid",
 
    "freejoint": true, 
 
    "joint_properties": { 
        "*": {
            "frictionloss": 0.001,
            "damping": 0.5,
            "armature": 0.01
        },
        "passive*": {
            "actuated": false
        },
        "slider*": {
            "actuated": true,
            "type": "position",
            "kp": 500,
            "forcerange": 20
        },
        "dof_wheel_*": {
            "actuated": true,
            "type": "velocity",
            "kv": 100,
            "forcerange": 20
        }
    },
    "equalities": {
        "closing_*": {
            "solref": "0.004 1",
            "solimp": "0.900 0.999 0.001"

        }
    }
}
 